
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submit Tenant Report | TrustTenant</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles/main.css">
</head>

<body class="submit-report-pg">
    <div><%- include("partials/header.ejs"); %></div>

    <main class="submit-report-cont">
        <h1>Submit Tenant Report</h1>
        <p>Share your rental experience with a previous tenant.</p>

        <form action="/submitReport" method="POST">

            <h2>Tenant Information</h2>

            <label for="firstName">First Name</label>
            <input type="text" id="firstName" name="firstName" maxlength="100" required>

            <label for="lastName">Last Name</label>
            <input type="text" id="lastName" name="lastName" maxlength="100" required>

            <h2>Rental Information</h2>

            <label for="propertyAddress">Property Address</label>
            <input type="text" id="propertyAddress" name="propertyAddress" required>

            <label for="tenancyStart">Tenancy Start Date</label>
            <input type="date" id="tenancyStart" name="tenancyStart" required>

            <label for="tenancyEnd">Tenancy End Date</label>
            <input type="date" id="tenancyEnd" name="tenancyEnd">

            <h2>Rental Experience</h2>

            <label for="paymentHistory">Rent Payment History</label>
            <select id="paymentHistory" name="paymentHistory" required>
                <option value="">Select an option</option>
                <option value="on_time">Always on time</option>
                <option value="occasionally_late">Occasionally late</option>
                <option value="frequently_late">Frequently late</option>
            </select>

            <label for="propertyCondition">Property Condition</label>
            <select id="propertyCondition" name="propertyCondition" required>
                <option value="">Select an option</option>
                <option value="good">Good</option>
                <option value="fair">Fair</option>
                <option value="poor">Poor</option>
            </select>

            <label for="description">Additional Comments</label>
            <textarea id="description" name="description" rows="5"
                      maxlength="2000"
                      placeholder="Describe your rental experience"></textarea>

            <label for="wouldRentAgain">Would You Rent to This Tenant Again?</label>
            <select id="wouldRentAgain" name="wouldRentAgain" required>
                <option value="">Select an option</option>
                <option value="yes">Yes</option>
                <option value="no">No</option>
                <option value="unsure">Unsure</option>
            </select>

            <p class="report-notice">
                Demo only. Use fictional tenant information.
                Reports are not verified tenant references.
            </p>

            <button type="submit" class="report-submit-btn">
                Submit Report
            </button>
        </form>
    </main>

    <div><%- include("partials/footer.ejs"); %></div>
</body>
</html>
