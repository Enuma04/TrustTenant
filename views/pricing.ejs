
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pricing - TrustTenant</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/main.css">
</head>

<body class="pricing-pg">
    <div class="container py-3">
        <header>
            <div class="pricing-header p-3 pb-md-4 mx-auto text-center">
                <h1 class="display-4 fw-normal text-body-emphasis">Pricing</h1>

                <p class="fs-5 text-body-secondary">
                    Simple, flexible pricing for property owners.
                    TrustTenant is designed to make documenting rental
                    experiences, accessing available rental-history reports,
                    and communicating with other users easier.
                    Choose the plan that works best for you.
                </p>

                <p class="small text-body-secondary mt-3">
                    <strong>Demo Notice:</strong>
                    The prices and subscription plans shown below are for
                    demonstration purposes only. Payments and subscriptions
                    are not currently available. Do not enter real personal,
                    sensitive, or identifying information on this website.
                </p>
            </div>
        </header>

        <main>
            <div class="row row-cols-1 row-cols-md-3 mb-3 text-center">

                <!-- MONTHLY PLAN -->
                <div class="col">
                    <div class="card mb-4 rounded-3 shadow-sm">
                        <div class="card-header py-3">
                            <h4 class="my-0 fw-normal">Monthly</h4>
                        </div>

                        <div class="card-body">
                            <h1 class="card-title pricing-card-title">
                                $15
                                <small class="text-body-secondary fw-light">/mo</small>
                            </h1>

                            <ul class="list-unstyled mt-3 mb-4">
                                <li>Submit rental-history reports</li>
                                <li>Search available approved reports</li>
                                <li>View detailed rental information</li>
                                <li>Access built-in messaging</li>
                                <li>Flexible monthly billing</li>
                            </ul>

                            <button type="button"
                                class="w-100 btn btn-lg"
                                style="background-color: orange;"
                                disabled>
                                Coming Soon
                            </button>
                        </div>
                    </div>
                </div>

                <!-- YEARLY PLAN -->
                <div class="col">
                    <div class="card mb-4 rounded-3 shadow-sm">
                        <div class="card-header py-3" style="background-color: orange;">
                            <h4 class="my-0 fw-normal">Yearly</h4>
                        </div>

                        <div class="card-body">
                            <h1 class="card-title pricing-card-title">
                                $150
                                <small class="text-body-secondary fw-light">/yr</small>
                            </h1>

                            <ul class="list-unstyled mt-3 mb-4">
                                <li>Submit rental-history reports</li>
                                <li>Search available approved reports</li>
                                <li>View detailed rental information</li>
                                <li>Access built-in messaging</li>
                                <li>Save $30 compared to monthly pricing</li>
                            </ul>

                            <button type="button"
                                class="w-100 btn btn-lg"
                                style="background-color: orange;"
                                disabled>
                                Coming Soon
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <%- include("partials/footer.ejs"); %>

    <script src="/js/script.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
