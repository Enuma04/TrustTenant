
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Messages - TrustTenant</title>
    <link rel="stylesheet" href="/styles/main.css">
</head>

<body class="chat-pg">
    <%- include("partials/header.ejs") %>

    <main class="chat-layout">

        <!-- Left: Conversation List -->
        <aside class="chat-sidebar">

            <div class="chat-inbox-header">
                <div>
                    <h1>Messages</h1>
                    <p>Your conversations</p>
                </div>

                <button id="search-button" type="button">
                    + New Chat
                </button>
            </div>

            <div id="search-container">
                <input
                    type="text"
                    id="search-bar"
                    placeholder="Search for a person..."
                    style="display: none;"
                >
                <div id="search-results"></div>
            </div>

            <div class="chat-list">
                <% if (users && users.length > 0) { %>
                    <% users.forEach(user => { %>
                        <a
                            href="/chat?user_id=<%= user.user_id %>"
                            class="user-link <%= receiverId === user.user_id ? 'active-chat' : '' %>"
                        >
                            <div class="chat-avatar">
                                <%= user.first_name.charAt(0).toUpperCase() %>
                            </div>

                            <div class="chat-user-info">
                                <strong>
                                    <%= user.first_name %> <%= user.last_name %>
                                </strong>
                                <span>Open conversation</span>
                            </div>
                        </a>
                    <% }) %>
                <% } else { %>
                    <div class="chat-empty">
                        <p>No conversations yet.</p>
                        <p>Click New Chat to find someone to message.</p>
                    </div>
                <% } %>
            </div>

        </aside>

        <!-- Right: Selected Conversation -->
        <section class="chat-main">

            <% if (selectedUser) { %>

                <div class="conversation-header">
                    <div class="conversation-avatar">
                        <%= selectedUser.first_name.charAt(0).toUpperCase() %>
                    </div>

                    <h2>
                        <%= selectedUser.first_name %>
                        <%= selectedUser.last_name %>
                    </h2>
                </div>

                <div id="chat-messages">
                    <% messages.forEach(message => { %>
                        <div class="<%= message.sender_id === senderId
                            ? 'sender-messages'
                            : 'receiver-messages' %>">
                            <p><%= message.content %></p>
                        </div>
                    <% }) %>
                </div>

                <div class="message-composer">
                    <input type="hidden" id="sender-id" value="<%= senderId %>">
                    <input type="hidden" id="receiver-id" value="<%= receiverId %>">

                    <textarea
                        id="message"
                        placeholder="Type a message..."
                        rows="1"
                        maxlength="2000"
                    ></textarea>

                    <button type="button" id="send-message">
                        Send
                    </button>
                </div>

            <% } else { %>

                <div class="chat-placeholder">
                    <div class="chat-placeholder-icon">✉</div>
                    <h2>Your Messages</h2>
                    <p>Select a conversation or start a new chat.</p>
                </div>

            <% } %>

        </section>

    </main>

    <script src="/socket.io/socket.io.js"></script>
</body>
</html>
