
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Messages - TrustTenant</title>
    <link rel="stylesheet" href="/styles/main.css">
</head>

<body class="message-pg">
    <%- include("partials/header.ejs") %>

    <main class="message-cont">
        <section class="conversation-panel">

            <div class="conversation-header">
                <a href="/chat" class="conversation-back">← Messages</a>
                <div class="conversation-avatar">
                    <%= name.charAt(0).toUpperCase() %>
                </div>
                <h1><%= name %></h1>
            </div>

            <div id="chat-messages">
                <% messages.forEach(message => { %>
                    <% if (message.sender_id === senderId) { %>
                        <div class="sender-messages">
                            <p><%= message.content %></p>
                        </div>
                    <% } else { %>
                        <div class="receiver-messages">
                            <p><%= message.content %></p>
                        </div>
                    <% } %>
                <% }) %>
            </div>

            <div class="message-composer">
                <input type="hidden" id="sender-id" value="<%= senderId %>">
                <input type="hidden" id="receiver-id" value="<%= receiverId %>">

                <textarea
                    id="message"
                    placeholder="Type a message..."
                    rows="1"
                ></textarea>

                <button type="button" id="send-message">
                    Send
                </button>
            </div>

        </section>
    </main>

    <script src="/socket.io/socket.io.js"></script>
</body>
</html>
