
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile | TrustTenant</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles/main.css">

    <style>
        body {
            display: block;
            background-color: #FFF8ED;
            min-height: 100vh;
            margin: 0;
            color: #212529;
        }

        .profile-container {
            width: 100%;
            max-width: 780px;
            margin: 55px auto;
            padding: 0 20px;
        }

        .profile-card {
            background-color: white;
            border: 1px solid #E9ECEF;
            border-radius: 18px;
            padding: 40px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
        }

        .profile-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 35px;
        }

        .profile-avatar {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            background-color: #FFA500;
            color: #212529;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 27px;
            font-weight: 600;
            flex-shrink: 0;
        }

        .profile-name {
            font-size: 27px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .role-badge {
            display: inline-block;
            background-color: #FFF0D2;
            color: #805000;
            border-radius: 20px;
            padding: 5px 12px;
            font-size: 13px;
            font-weight: 500;
            text-transform: capitalize;
        }

        .section-title {
            font-size: 17px;
            font-weight: 600;
            margin-bottom: 25px;
        }

        .profile-label {
            color: #777;
            font-size: 14px;
            margin-bottom: 6px;
        }

        .profile-value {
            font-size: 16px;
            font-weight: 500;
            margin-bottom: 28px;
            overflow-wrap: anywhere;
        }

        .btn-orange {
            background-color: #FFA500;
            color: #212529;
            border: none;
            border-radius: 8px;
            padding: 10px 18px;
            font-weight: 500;
        }

        .btn-orange:hover {
            background-color: #E69500;
            color: #212529;
        }

        .profile-divider {
            border-color: #E9ECEF;
            opacity: 1;
            margin: 10px 0 28px;
        }

        @media (max-width: 576px) {
            .profile-container {
                margin: 25px auto;
                padding: 0 12px;
            }

            .profile-card {
                padding: 24px;
            }

            .profile-avatar {
                width: 60px;
                height: 60px;
                font-size: 22px;
            }

            .profile-name {
                font-size: 22px;
            }

            .profile-header {
                gap: 14px;
            }
        }
    </style>
</head>

<body>

<main class="profile-container">
    <div class="profile-card">

        <!-- Back navigation -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="fs-4 fw-semibold mb-0">My Profile</h1>
            <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
                Back to Dashboard
            </a>
        </div>

        <!-- Profile identity -->
        <div class="profile-header">
            <div class="profile-avatar">
                <%= user.first_name.charAt(0).toUpperCase() %><%= user.last_name.charAt(0).toUpperCase() %>
            </div>

            <div>
                <h2 class="profile-name">
                    <%= user.first_name %> <%= user.last_name %>
                </h2>
                <span class="role-badge"><%= user.role %></span>
            </div>
        </div>

        <hr class="profile-divider">

        <!-- Account details -->
        <h3 class="section-title">Personal Information</h3>

        <div class="row">
            <div class="col-md-6">
                <p class="profile-label">First Name</p>
                <p class="profile-value"><%= user.first_name %></p>
            </div>

            <div class="col-md-6">
                <p class="profile-label">Last Name</p>
                <p class="profile-value"><%= user.last_name %></p>
            </div>

            <div class="col-md-6">
                <p class="profile-label">Email Address</p>
                <p class="profile-value"><%= user.email %></p>
            </div>

            <div class="col-md-6">
                <p class="profile-label">Phone Number</p>
                <p class="profile-value">
                    <%= user.phone_number || "Not provided" %>
                </p>
            </div>

            <% if (user.role === "landlord") { %>
                <div class="col-md-6">
                    <p class="profile-label">Company Name</p>
                    <p class="profile-value">
                        <%= user.company_name || "Not provided" %>
                    </p>
                </div>
            <% } %>

            <div class="col-md-6">
                <p class="profile-label">Member Since</p>
                <p class="profile-value">
                    <%= new Date(user.created_at).toLocaleDateString("en-CA", {
                        year: "numeric",
                        month: "long",
                        day: "numeric"
                    }) %>
                </p>
            </div>
        </div>

        <hr class="profile-divider">

        <!-- Account actions -->
        <div class="d-flex flex-wrap gap-3">
            <a href="/settings" class="btn btn-orange">
                Account Settings
            </a>

            <a href="/dashboard" class="btn btn-outline-secondary">
                Return to Dashboard
            </a>
        </div>

    </div>
</main>

</body>
</html>
